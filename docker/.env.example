# ──────────────────────────────────────────────────────────────────────────────
# Environment Variables Template
# Copy to .env and fill in values. NEVER commit .env to git.
# In production: use Azure Key Vault + Azure Container Apps secrets.
# ──────────────────────────────────────────────────────────────────────────────

# Application
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Security — generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_32_CHAR_MINIMUM_SECRET_KEY_HERE

# Azure AD
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_KEY_VAULT_URL=https://kv-churn-analytics.vault.azure.net/

# Database (Azure SQL in production)
# Local dev: postgresql+asyncpg://churn_user:dev_password@localhost:5432/churn_analytics
DATABASE_URL=postgresql+asyncpg://churn_user:dev_password@postgres:5432/churn_analytics
DB_POOL_SIZE=20

# Azure Storage
AZURE_STORAGE_ACCOUNT=your_storage_account
AZURE_STORAGE_KEY=your_storage_key

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
# Production: azureml://westeurope.api.azureml.ms/mlflow/v1.0/subscriptions/...

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com/
AZURE_OPENAI_API_KEY=your_openai_api_key
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Azure Cognitive Search (RAG)
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_KEY=your_search_admin_key

# Redis
REDIS_URL=redis://:dev_redis_password@redis:6379/0
REDIS_PASSWORD=dev_redis_password

# GDPR
PII_MASKING_SALT=REPLACE_WITH_RANDOM_32_CHAR_SALT
DPO_EMAIL=dpo@your-company.com

# Monitoring
APP_INSIGHTS_CONNECTION_STRING=InstrumentationKey=...
GRAFANA_PASSWORD=admin_replace_me
